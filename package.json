{
    "name":  "upsa-claims",
    "version":  "1.0.0",
    "private":  true,
    "scripts":  {
                    "dev":  "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
                    "dev:api":  "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
                    "dev:web":  "vite --config apps/web/vite.config.ts",
                    "build":  "npm run build:api \u0026\u0026 npm run build:web",
                    "build:api":  "tsc -p apps/api/tsconfig.json",
                    "build:web":  "vite build --config apps/web/vite.config.ts",
                    "build:vercel":  "npm run db:generate && npm run build:web",
                    "typecheck":  "tsc -p apps/api/tsconfig.json --noEmit \u0026\u0026 tsc -p apps/web/tsconfig.json --noEmit",
                    "lint":  "eslint apps scripts tests",
                    "test":  "vitest run",
                    "test:integration":  "npm run build:api && node scripts/test-foundation.mjs",
                    "test:e2e":  "playwright test",
                    "db:generate":  "prisma generate --schema apps/api/prisma/schema.prisma",
                    "db:migrate":  "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
                    "db:seed":  "tsx --tsconfig apps/api/tsconfig.json apps/api/prisma/seed.ts",
                    "db:local":  "node scripts/local-database.mjs",
                    "start":  "node apps/api/dist/main.js"
                },
    "dependencies":  {
                         "@nestjs/common":  "^11.0.0",
                         "@nestjs/core":  "^11.0.0",
                         "@nestjs/platform-express":  "^11.0.0",
                         "@nestjs/jwt":  "^11.0.0",
                         "@nestjs/throttler":  "^6.4.0",
                         "@prisma/client":  "6.19.0",
                         "bcryptjs":  "^3.0.2",
                         "cookie-parser":  "^1.4.7",
                         "decimal.js":  "^10.6.0",
                         "dotenv":  "^16.6.0",
                         "helmet":  "^8.1.0",
                         "lucide-react":  "^0.468.0",
                         "pdfkit":  "^0.17.0",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "react-router-dom":  "^7.0.0",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.2",
                         "zod":  "^3.25.0"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.0.0",
                            "@playwright/test":  "^1.55.0",
                            "@types/cookie-parser":  "^1.4.9",
                            "@types/express":  "^5.0.0",
                            "@types/node":  "^22.0.0",
                            "@types/pdfkit":  "^0.17.0",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "@vitejs/plugin-react":  "^4.7.0",
                            "concurrently":  "^9.2.0",
                            "embedded-postgres":  "18.4.0-beta.17",
                            "eslint":  "^9.0.0",
                            "globals":  "^16.0.0",
                            "prisma":  "6.19.0",
                            "tsx":  "^4.20.0",
                            "typescript":  "^5.9.0",
                            "typescript-eslint":  "^8.0.0",
                            "vite":  "^6.3.0",
                            "vitest":  "^3.2.0"
                        }
}
