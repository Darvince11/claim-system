{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "apps/web/dist",
  "functions": {"api/[...path].ts": {"maxDuration": 30}},
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/[...path].ts"},
    {"handle": "filesystem"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
